{
    "parse": [
        {
            "name": "必須のパラメータだけを指定する",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&rects=3:72,140.5,240,18",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [{ "page": 3, "rects": [[72, 140.5, 240, 18]] }]
            }
        },
        {
            "name": "バージョンを明示し、複数の矩形と検索用テキストを指定する",
            "query": "v=1&src=zotero:ABCD1234&sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&rects=12:72,140,240,18_72,158,180,18&label=iv&q=%E5%9B%B32",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [
                    {
                        "page": 12,
                        "rects": [
                            [72, 140, 240, 18],
                            [72, 158, 180, 18]
                        ]
                    }
                ],
                "label": "iv",
                "q": "図2"
            }
        },
        {
            "name": "複数のページにまたがる範囲を指定する",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:72,700,240,18_4:72,60,240,40_72,100,120,18",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [
                    { "page": 3, "rects": [[72, 700, 240, 18]] },
                    {
                        "page": 4,
                        "rects": [
                            [72, 60, 240, 40],
                            [72, 100, 120, 18]
                        ]
                    }
                ]
            }
        },
        {
            "name": "SHA-256 の先頭 16 桁を受け付ける",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 1, 1]] }]
            }
        },
        {
            "name": "16 桁未満の SHA-256 はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcde&rects=1:0,0,1,1",
            "error": "invalid sha256"
        },
        {
            "name": "未対応のバージョンはエラーとする",
            "query": "v=2&src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "unsupported version: 2"
        },
        {
            "name": "未知の取得元の名前空間はエラーとする",
            "query": "src=paperless:12&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "invalid src"
        },
        {
            "name": "大文字を含む SHA-256 はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789ABCDEF&rects=1:0,0,1,1",
            "error": "invalid sha256"
        },
        {
            "name": "先頭の矩形にページ番号がない場合はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページ番号 0 はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=0:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "昇順でないページ番号はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=4:0,0,1,1_3:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "矩形を含まないページはエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:_4:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "幅が 0 の矩形はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,0,1",
            "error": "invalid rects"
        },
        {
            "name": "10 進数でない座標値はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1e3,1",
            "error": "invalid rects"
        },
        {
            "name": "rects がない場合はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef",
            "error": "invalid rects"
        },
        {
            "name": "全ページの矩形の合計が上限を超える場合はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_2:0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "重複するページ番号はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:0,0,1,1_3:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "上限を超えるページ番号はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=100001:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "先頭に 0 を含むページ番号はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=03:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "上限を超える座標値はエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:100000.1,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "負の座標値を受け付け、負の 0 は 0 として解釈する",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:-10.5,-0,1,1",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[-10.5, 0, 1, 1]] }]
            }
        },
        {
            "name": "同じ名前のパラメータが複数ある場合はエラーとする",
            "query": "src=zotero:ABCD1234&src=zotero:EFGH5678&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "duplicate parameter: src"
        },
        {
            "name": "上限を超える検索用テキストはエラーとする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1&q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "error": "q too long"
        },
        {
            "name": "空の検索用テキストとページラベルは省略として扱う",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1&label=&q=",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 1, 1]] }]
            }
        }
    ],
    "format": [
        {
            "name": "座標値を小数第 1 位に丸め、SHA-256 を先頭 16 桁に短縮し、v=1 を省略する",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [
                    { "page": 2, "rects": [[72.04, 140.06, 239.95, 18]] }
                ],
                "q": "図2"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=2:72,140.1,240,18&q=%E5%9B%B32"
        },
        {
            "name": "各ページの先頭の矩形にページ番号を付与する",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [
                    { "page": 3, "rects": [[72, 700, 240, 18]] },
                    {
                        "page": 4,
                        "rects": [
                            [72, 60, 240, 40],
                            [72, 100, 120, 18]
                        ]
                    }
                ],
                "label": "iv"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:72,700,240,18_4:72,60,240,40_72,100,120,18&label=iv"
        },
        {
            "name": "丸めると 0 になる幅と高さは 0.1 とし、検索用テキストとページラベルの記号は符号化する",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 0.04, 0.02]] }],
                "label": "iv–v",
                "q": "a; b, c:"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,0.1,0.1&label=iv%E2%80%93v&q=a%3B+b%2C+c%3A"
        }
    ],
    "sameVersion": [
        {
            "name": "先頭 16 桁が一致する場合は同じバージョンと判定する",
            "link": "0123456789abcdef",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": true
        },
        {
            "name": "64 桁すべてが一致する場合は同じバージョンと判定する",
            "link": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": true
        },
        {
            "name": "先頭 16 桁が異なる場合は別のバージョンと判定する",
            "link": "fedcba9876543210",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": false
        }
    ]
}
