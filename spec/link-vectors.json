            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_2:0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1_0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページが同じ番号を繰り返す",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:0,0,1,1_3:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページが上限を超える",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=100001:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページに先頭の 0 がある",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=03:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "座標が上限を超える",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:100000.1,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "負の座標と負の 0 を受け付け、負の 0 は 0 とする",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:-10.5,-0,1,1",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[-10.5, 0, 1, 1]] }]
            }
        },
        {
            "name": "同じ名前のパラメータが複数ある",
            "query": "src=zotero:ABCD1234&src=zotero:EFGH5678&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "duplicate parameter: src"
        },
        {
            "name": "目印が上限を超える",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1&q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "error": "q too long"
        },
        {
            "name": "空の目印とページラベルは省略と同じに扱う",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1&label=&q=",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 1, 1]] }]
            }
        }
    ],
    "format": [
        {
            "name": "座標を小数第 1 位に丸め、SHA-256 を先頭 16 桁にし、v=1 は省く",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [
                    { "page": 2, "rects": [[72.04, 140.06, 239.95, 18]] }
                ],
                "q": "図2"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=2:72,140.1,240,18&q=%E5%9B%B32"
        },
        {
            "name": "ページごとに先頭の矩形へページを付ける",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [
                    { "page": 3, "rects": [[72, 700, 240, 18]] },
                    {
                        "page": 4,
                        "rects": [
                            [72, 60, 240, 40],
                            [72, 100, 120, 18]
                        ]
                    }
                ],
                "label": "iv"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:72,700,240,18_4:72,60,240,40_72,100,120,18&label=iv"
        },
        {
            "name": "丸めて 0 になる幅と高さは 0.1 にし、目印とページラベルの記号は符号化する",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 0.04, 0.02]] }],
                "label": "iv–v",
                "q": "a; b, c:"
            },
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,0.1,0.1&label=iv%E2%80%93v&q=a%3B+b%2C+c%3A"
        }
    ],
    "sameVersion": [
        {
            "name": "先頭 16 桁が一致する",
            "link": "0123456789abcdef",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": true
        },
        {
            "name": "64 桁すべてが一致する",
            "link": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": true
        },
        {
            "name": "先頭 16 桁が異なる",
            "link": "fedcba9876543210",
            "pdf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "same": false
        }
    ]
}
