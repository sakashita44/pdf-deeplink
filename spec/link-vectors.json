{
    "parse": [
        {
            "name": "最小の指定",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&rects=3:72,140.5,240,18",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [{ "page": 3, "rects": [[72, 140.5, 240, 18]] }]
            }
        },
        {
            "name": "版を明示し、複数の矩形と目印を持つ",
            "query": "v=1&src=zotero:ABCD1234&sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&rects=12:72,140,240,18_72,158,180,18&label=iv&q=%E5%9B%B32",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "regions": [
                    {
                        "page": 12,
                        "rects": [
                            [72, 140, 240, 18],
                            [72, 158, 180, 18]
                        ]
                    }
                ],
                "label": "iv",
                "q": "図2"
            }
        },
        {
            "name": "複数のページにまたがる",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:72,700,240,18_4:72,60,240,40_72,100,120,18",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [
                    { "page": 3, "rects": [[72, 700, 240, 18]] },
                    {
                        "page": 4,
                        "rects": [
                            [72, 60, 240, 40],
                            [72, 100, 120, 18]
                        ]
                    }
                ]
            }
        },
        {
            "name": "SHA-256 の先頭 16 桁",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "link": {
                "src": "zotero:ABCD1234",
                "sha256": "0123456789abcdef",
                "regions": [{ "page": 1, "rects": [[0, 0, 1, 1]] }]
            }
        },
        {
            "name": "SHA-256 が 16 桁未満",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcde&rects=1:0,0,1,1",
            "error": "invalid sha256"
        },
        {
            "name": "未対応の版",
            "query": "v=2&src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "unsupported version: 2"
        },
        {
            "name": "取得元の名前空間が不明",
            "query": "src=paperless:12&sha256=0123456789abcdef&rects=1:0,0,1,1",
            "error": "invalid src"
        },
        {
            "name": "SHA-256 が大文字",
            "query": "src=zotero:ABCD1234&sha256=0123456789ABCDEF&rects=1:0,0,1,1",
            "error": "invalid sha256"
        },
        {
            "name": "先頭の矩形にページがない",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページが 0",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=0:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページが昇順でない",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=4:0,0,1,1_3:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "ページに矩形がない",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=3:_4:0,0,1,1",
            "error": "invalid rects"
        },
        {
            "name": "矩形の幅が 0",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,0,1",
            "error": "invalid rects"
        },
        {
            "name": "矩形の値が数値でない",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef&rects=1:0,0,1e3,1",
            "error": "invalid rects"
        },
        {
            "name": "矩形がない",
            "query": "src=zotero:ABCD1234&sha256=0123456789abcdef",
            "error": "invalid rects"
        },
        {
