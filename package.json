{
    "name": "pdf-deeplink",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev:web": "vite",
        "dev:server": "node --watch server/main.ts",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "node --test",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{ts,tsx}\" && eslint --fix .",
        "format:check": "prettier --check \"**/*.{ts,tsx}\""
    },
    "dependencies": {
        "pdfjs-dist": "6.5.438"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "prettier": "3.10.1",
        "typescript": "7.0.2",
        "typescript-eslint": "8.74.0",
        "vite": "8.3.8"
    },
    "description": "PDF 上の文章や範囲を指すリンクを発行し、リンクから該当箇所を強調表示する Web アプリ"
}
